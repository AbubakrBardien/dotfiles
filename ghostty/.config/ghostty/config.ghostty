#=====================================
# Font Config
#=====================================

# font-family = "JetBrainsMono Nerd Font"
font-family = "JetBrainsMono NF SemiBold"
font-size = 12

# Enable programming ligatures
font-feature = calt
font-feature = liga

#=====================================
# Theme & Colors
#=====================================

theme = TokyoNight Night

# Cursor styling
cursor-style = block
cursor-style-blink = false

#=====================================
# WINDOW & UI
#=====================================

# Window padding (in pixels)
window-padding-x = 4
window-padding-y = 0

# Scrollback buffer history limit (lines)
scrollback-limit = 10000

confirm-close-surface = false
