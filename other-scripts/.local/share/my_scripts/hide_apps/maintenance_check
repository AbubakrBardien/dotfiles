#!/usr/bin/env bash

path="$SCRIPTS/hide_apps"
hidden_apps_file="${path}/apps_to_hide.txt"

# Resolve all XDG application directories dynamically
IFS=':' read -ra DATA_DIRS <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

APP_DIRS=()
for dir in "${DATA_DIRS[@]}"; do
	if [[ -d "$dir/applications" ]]; then
		APP_DIRS+=("$dir/applications")
	fi
done

# Prunes app names from the hide list if their .desktop file no longer exists in ANY XDG directory
remove_nonexistent_apps() {
	[[ ! -f "$hidden_apps_file" ]] && return

	local temp_installed
	temp_installed=$(mktemp)

	# Gather all installed desktop entry basenames across all XDG directories
	for app_dir in "${APP_DIRS[@]}"; do
		fd --maxdepth 1 -e desktop . "$app_dir" | xargs -r -n1 basename -s .desktop
	done | sort -u >"$temp_installed"

	# Keep only apps that are both in the hide list AND currently installed
	comm -12 "$temp_installed" <(sort "$hidden_apps_file") >"${path}/result_file.txt"
	cat "${path}/result_file.txt" >"$hidden_apps_file"
	rm "${path}/result_file.txt" "$temp_installed"
}

# Shows applications installed on the system that are NOT in your hide list
maintenance_info() {
	local temp_installed
	temp_installed=$(mktemp)

	for app_dir in "${APP_DIRS[@]}"; do
		fd --maxdepth 1 -e desktop . "$app_dir" | xargs -r -n1 basename -s .desktop
	done | sort -u >"$temp_installed"

	comm -23 "$temp_installed" <(sort "$hidden_apps_file")
	rm "$temp_installed"
}

# 1. Clean up stale entries from your merged list
remove_nonexistent_apps

# 2. Display unhidden applications
printf 'Desktop Files that are NOT marked as hidden:\n\n'
maintenance_info
